    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0211",
    "t": [
      1167.9,
      1171.5
    ],
    "speaker": "多多爸爸",
    "text": "对 怎么 这个事情难道是我自己想象出来"
