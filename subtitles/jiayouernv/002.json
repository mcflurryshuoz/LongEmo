    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0172",
    "t": [
      942.34,
      947.34
    ],
    "speaker": "夏东海",
    "text": "来来来 冷静冷静 快点 那留心吧 把说完吗"
