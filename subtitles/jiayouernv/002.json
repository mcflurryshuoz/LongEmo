    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0210",
    "t": [
      1163.26,
      1167.9
    ],
    "speaker": "夏东海",
    "text": "您听我解释 听我解释 这个事情又可能不是你想象了那样"
