    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0217",
    "t": [
      1200.46,
      1202.7
    ],
    "speaker": "夏雨",
    "text": "多多 I love you"
  },
  {
    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0218",
    "t": [
      1202.7,
      1213.06
    ],
    "speaker": "多多爸爸",
