    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0170",
    "t": [
      934.34,
      940.34
    ],
    "speaker": "刘星",
    "text": "妈我跟您商量点事 您给点资金城吗 我想把这玩意染成绿的"
