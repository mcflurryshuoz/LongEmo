    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0214",
    "t": [
      1189.62,
      1191.02
    ],
    "speaker": "多多爸爸",
    "text": "喜欢啊"
  },
  {
    "series": "jiayouernv",
    "ep": "002",
    "unit_id": "u0215",
    "t": [
      1191.02,
      1199.7
    ],
    "speaker": "夏东海",
    "text": "他的意思是说 他的喜欢 绝无半点骚扰的意思 对 当然我会尽快 让他回归中国国情的"
  },
