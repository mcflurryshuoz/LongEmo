    "series": "jiayouernv",
    "ep": "007",
    "unit_id": "u0073",
    "t": [
      417.26,
      424.26
    ],
    "speaker": "夏雪",
    "text": "对了 还有点事 我走了以后 大家不要想我呀 拜拜 拜拜"
