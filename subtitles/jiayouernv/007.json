  {
    "series": "jiayouernv",
    "ep": "007",
    "unit_id": "u0066",
    "t": [
      385.26,
      400.26
    ],
    "speaker": "夏雪",
    "text": "我们的了解啊 真的太少了 大星星啊 是一种很合群的动物 他们很少打价的 算了 反正啊 您也不懂这些东西 您呢 你就别跟着瞎唱歌了 那我就走了"
  },
  {
    "series": "jiayouernv",
    "ep": "007",
    "unit_id": "u0067",
    "t": [
      400.26,
      403.26
    ],
    "speaker": "夏东海",
    "text": "好 走了 走了"
  },
  {
    "series": "jiayouernv",
    "ep": "007",
    "unit_id": "u0068",
    "t": [
      403.26,
      405.26
    ],
    "speaker": "夏雨",
    "text": "走了 那我就不送了"
