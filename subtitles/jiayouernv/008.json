    "series": "jiayouernv",
    "ep": "008",
    "unit_id": "u0231",
    "t": [
      1240.34,
      1243.34
    ],
    "speaker": "刘梅",
    "text": "我跟你爸爸这么精明的人 能被你给蒙了吗"
