  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0023",
    "t": [
      158.0,
      160.0
    ],
    "speaker": "刘星",
    "text": "妈 我们这儿没小金思豪"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0024",
    "t": [
      160.0,
      163.0
    ],
    "speaker": "刘梅",
    "text": "刘先生你来给到我 妈 什么"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0025",
    "t": [
      163.0,
      173.0
    ],
    "speaker": "刘星",
    "text": "妈 妈 妈 妈 你成发我什么都成 妈 你成发我什么都成 妈 妈 妈"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0026",
    "t": [
      173.0,
      176.0
    ],
    "speaker": "刘梅",
    "text": "妈什么都不成发你 妈就成发你喝牛奶"
  },
