  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0256",
    "t": [
      1278.72,
      1280.72
    ],
    "speaker": "刘梅",
    "text": "就是那种 也是那种"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0257",
    "t": [
      1282.72,
      1286.72
    ],
    "speaker": "刘梅",
    "text": "全家每一个人 每天晚上 还要讲例一杯牛奶"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0258",
    "t": [
      1288.72,
      1290.72
    ],
    "speaker": "夏雨",
    "text": "有什么 有"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0259",
    "t": [
      1290.72,
      1292.72
    ],
    "speaker": "刘星",
    "text": "是不是早上那边就给取消了"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0260",
    "t": [
      1292.72,
      1299.72
    ],
    "speaker": "刘梅",
    "text": "坚决不取消 但是可以让刘星取消 可以让他的牛奶 盖成豆漆 怎么样"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0261",
    "t": [
      1299.72,
      1301.72
    ],
    "speaker": "夏雨",
    "text": "妈妈再也不逼你了"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0262",
    "t": [
      1301.72,
      1307.72
    ],
    "speaker": "刘星",
    "text": "太好了 妈你太伟大了 我得拥抱你 好"
  },
