[
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0001",
    "t": [
      0.0,
      3.0
    ],
    "speaker": "刘星",
    "text": "我跟你伤了点事"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0002",
    "t": [
      4.0,
      6.0
    ],
    "speaker": "刘梅",
    "text": "先给我把奶喝了 什么都好伤了"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0003",
    "t": [
      6.0,
      9.0
    ],
    "speaker": "刘星",
    "text": "问你事 我跟那伤呢 就是那牛奶的事"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0004",
    "t": [
      11.0,
      14.0
    ],
    "speaker": "刘梅",
    "text": "一天一杯 一口不去啥 没什么伤了呢"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0005",
    "t": [
      14.0,
      25.0
    ],
    "speaker": "刘星",
    "text": "你没听有人说吗 你自己想吃什么 或者想喝什么 就说明你自己身体里去什么 你不想吃什么 或者不想喝什么 说明你身体里不去这玩"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0006",
    "t": [
      26.0,
      28.0
    ],
    "speaker": "刘梅",
    "text": "想说说这扭论 你扭论"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0007",
    "t": [
      30.0,
      33.0
    ],
    "speaker": "刘梅",
    "text": "你知道人家管的 漂亮的男孩子 都叫什么吗"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0008",
    "t": [
      33.0,
      34.0
    ],
    "speaker": "夏雨",
    "text": "叫什么"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0009",
    "t": [
      34.0,
      36.0
    ],
    "speaker": "刘梅",
    "text": "奶油小声"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0010",
    "t": [
      37.0,
      40.0
    ],
    "speaker": "刘星",
    "text": "那照你这么说 奶油小声的 全是喝牛奶喝出来的"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0011",
    "t": [
      40.0,
      42.0
    ],
    "speaker": "刘梅",
    "text": "当然了"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0012",
    "t": [
      42.0,
      50.0
    ],
    "speaker": "刘星",
    "text": "那我就不用喝这牛奶了 什么 因为我不想当奶油小声 我想当硬看小声 姜文"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0013",
    "t": [
      50.0,
      51.0
    ],
    "speaker": "刘梅",
    "text": "是"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0014",
    "t": [
      53.0,
      57.0
    ],
    "speaker": "刘梅",
    "text": "人家姜文之所以 能成姜文 就因为她小时候 她毕业的天天喝牛奶了"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0015",
    "t": [
      57.0,
      59.0
    ],
    "speaker": "刘星",
    "text": "那她不喝牛奶吃吗"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0016",
    "t": [
      61.0,
      62.0
    ],
    "speaker": "刘星",
    "text": "成功用啊"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0017",
    "t": [
      86.0,
      88.0
    ],
    "speaker": "刘梅",
    "text": "成功用啊"
  },
  {
    "series": "jiayouernv",
    "ep": "011",
    "unit_id": "u0018",
    "t": [
      117.0,
      123.0
    ],
    "speaker": "夏雨",
    "text": "那我喝牛奶那么乖 那我找她像谁啊 喝"
  },
