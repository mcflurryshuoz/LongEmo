    "series": "jiayouernv",
    "ep": "016",
    "unit_id": "u0207",
    "t": [
      1278.92,
      1282.08
    ],
    "speaker": "刘星",
    "text": "谁说的 他们还不知道有水漂不平安的吗"
  },
  {
    "series": "jiayouernv",
    "ep": "016",
    "unit_id": "u0208",
    "t": [
      1283.72,
      1284.76
    ],
    "speaker": "ENSEMBLE",
    "text": "对不起"
  },
  {
    "series": "jiayouernv",
    "ep": "016",
    "unit_id": "u0209",
    "t": [
      1285.28,
      1287.16
    ],
    "speaker": "刘梅",
    "text": "没事 什么对不起"
  },
  {
    "series": "jiayouernv",
    "ep": "016",
