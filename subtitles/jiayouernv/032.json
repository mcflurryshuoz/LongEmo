    "series": "jiayouernv",
    "ep": "032",
    "unit_id": "u0150",
    "t": [
      1117.6,
      1122.6
    ],
    "speaker": "林凡",
    "text": "可我不行 你爸 就那大叔 他支持咱俩教我"
