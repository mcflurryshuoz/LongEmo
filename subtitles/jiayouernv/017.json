    "series": "jiayouernv",
    "ep": "017",
    "unit_id": "u0149",
    "t": [
      839.0,
      842.0
    ],
    "speaker": "刘梅",
    "text": "哎呀呀呀 你打枪怎么着干吗呢让人啊"
