    "series": "jiayouernv",
    "ep": "017",
    "unit_id": "u0067",
    "t": [
      387.0,
      389.0
    ],
    "speaker": "尚西山",
    "text": "你就是有点缺点就行"
  },
  {
    "series": "jiayouernv",
    "ep": "017",
    "unit_id": "u0068",
    "t": [
      391.0,
      393.0
    ],
    "speaker": "尚西山",
    "text": "在那个那个什么 他儿子一直改"
