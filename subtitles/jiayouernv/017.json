    "series": "jiayouernv",
    "ep": "017",
    "unit_id": "u0065",
    "t": [
      378.0,
      386.0
    ],
    "speaker": "尚西山",
    "text": "你好的天上去 他一直是个好人啊 做一个改 这个人得有点缺点 好 改成一个坏蛋"
