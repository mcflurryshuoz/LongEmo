    "series": "jiayouernv",
    "ep": "017",
    "unit_id": "u0041",
    "t": [
      230.0,
      234.8
    ],
    "speaker": "刘梅",
    "text": "就是你这样 细心白背 斗着呀 有往之前 辛苦开合 你肯定"
