    "series": "jiayouernv",
    "ep": "017",
    "unit_id": "u0137",
    "t": [
      767.0,
      773.0
    ],
    "speaker": "尚西山",
    "text": "已经取消了 放心 早的 赶紧后天了 下午天啊"
